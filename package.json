{
  "name": "respectabullz",
  "version": "1.10.4",
  "description": "Breeder management application for dog breeding operations",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeftHandVoodoo/Respectabullz.git"
  },
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "overrides": {
    "docx": {
      "nanoid": "5.1.16"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web",
    "build:web": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "demo:dev": "tauri dev --config src-tauri/tauri.demo.conf.json",
    "tauri:build": "tauri build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:ci": "vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --run --coverage",
    "check:versions": "node scripts/check-versions.mjs",
    "check:build-secrets": "node scripts/check-build-secrets.mjs",
    "check:demo-data": "node scripts/check-demo-data.mjs",
    "version:bump": "node scripts/bump-version.js",
    "version:check": "npm run check:versions"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@react-pdf/renderer": "^4.3.1",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "2.4.2",
    "@tauri-apps/plugin-fs": "^2.0.1",
    "@types/file-saver": "^2.0.7",
    "baseline-browser-mapping": "^2.11.18",
    "buffer": "^6.0.3",
    "caniuse-lite": "^1.0.30001809",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.454.0",
    "pdfjs-dist": "^5.4.296",
    "pizzip": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.53.1",
    "react-pdf": "^10.2.0",
    "react-router-dom": "^7.18.2",
    "react-to-print": "^3.0.2",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@hookform/resolvers": "^3.9.1",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.26",
    "prisma": "^5.22.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
