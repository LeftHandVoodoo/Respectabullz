{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Respectabullz Synthetic Demo",
  "identifier": "com.respectabullz.demo",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Respectabullz - Synthetic Portfolio Demo",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "synthetic-demo",
          "description": "Development-only permissions isolated from the production application identity.",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "dialog:default",
            "dialog:allow-open",
            "dialog:allow-save",
            "fs:deny-default",
            {
              "identifier": "fs:allow-exists",
              "allow": [
                { "path": "$APPDATA/photos" },
                { "path": "$APPDATA/photos/*" },
                { "path": "$APPDATA/contracts" },
                { "path": "$APPDATA/contracts/*" },
                { "path": "$APPDATA/documents" },
                { "path": "$APPDATA/documents/*" },
                { "path": "$APPDATA/logs" },
                { "path": "$APPDATA/logs/*" }
              ],
              "deny": [
                { "path": "$APPDATA/photos/.*" },
                { "path": "$APPDATA/photos/*/**" },
                { "path": "$APPDATA/contracts/.*" },
                { "path": "$APPDATA/contracts/*/**" },
                { "path": "$APPDATA/documents/.*" },
                { "path": "$APPDATA/documents/*/**" },
                { "path": "$APPDATA/logs/.*" },
                { "path": "$APPDATA/logs/*/**" }
              ]
            },
            {
              "identifier": "fs:allow-mkdir",
              "allow": [
                { "path": "$APPDATA/photos" },
                { "path": "$APPDATA/contracts" },
                { "path": "$APPDATA/logs" }
              ]
            },
            {
              "identifier": "fs:allow-read-file",
              "allow": [
                { "path": "$APPDATA/photos/*" },
                { "path": "$APPDATA/documents/*" },
                { "path": "$APPDATA/logs/*" }
              ],
              "deny": [
                { "path": "$APPDATA/photos" },
                { "path": "$APPDATA/photos/.*" },
                { "path": "$APPDATA/photos/*/**" },
                { "path": "$APPDATA/contracts" },
                { "path": "$APPDATA/contracts/.*" },
                { "path": "$APPDATA/contracts/*/**" },
                { "path": "$APPDATA/documents" },
                { "path": "$APPDATA/documents/.*" },
                { "path": "$APPDATA/documents/*/**" },
                { "path": "$APPDATA/logs" },
                { "path": "$APPDATA/logs/.*" },
                { "path": "$APPDATA/logs/*/**" }
              ]
            },
            {
              "identifier": "fs:allow-stat",
              "allow": [
                { "path": "$APPDATA/photos/*" }
              ],
              "deny": [
                { "path": "$APPDATA/photos" },
                { "path": "$APPDATA/photos/.*" },
                { "path": "$APPDATA/photos/*/**" },
                { "path": "$APPDATA/contracts" },
                { "path": "$APPDATA/contracts/.*" },
                { "path": "$APPDATA/contracts/*/**" },
                { "path": "$APPDATA/documents" },
                { "path": "$APPDATA/documents/.*" },
                { "path": "$APPDATA/documents/*/**" },
                { "path": "$APPDATA/logs" },
                { "path": "$APPDATA/logs/.*" },
                { "path": "$APPDATA/logs/*/**" }
              ]
            },
            {
              "identifier": "fs:allow-write-file",
              "allow": [
                { "path": "$APPDATA/photos/*" },
                { "path": "$APPDATA/contracts/*" },
                { "path": "$APPDATA/logs/*" }
              ],
              "deny": [
                { "path": "$APPDATA/photos" },
                { "path": "$APPDATA/photos/.*" },
                { "path": "$APPDATA/photos/*/**" },
                { "path": "$APPDATA/contracts" },
                { "path": "$APPDATA/contracts/.*" },
                { "path": "$APPDATA/contracts/*/**" },
                { "path": "$APPDATA/documents" },
                { "path": "$APPDATA/documents/.*" },
                { "path": "$APPDATA/documents/*/**" },
                { "path": "$APPDATA/logs" },
                { "path": "$APPDATA/logs/.*" },
                { "path": "$APPDATA/logs/*/**" }
              ]
            },
            {
              "identifier": "fs:allow-remove",
              "allow": [
                { "path": "$APPDATA/photos/*" },
                { "path": "$APPDATA/contracts/*" },
                { "path": "$APPDATA/logs/*" }
              ],
              "deny": [
                { "path": "$APPDATA/photos" },
                { "path": "$APPDATA/photos/.*" },
                { "path": "$APPDATA/photos/*/**" },
                { "path": "$APPDATA/contracts" },
                { "path": "$APPDATA/contracts/.*" },
                { "path": "$APPDATA/contracts/*/**" },
                { "path": "$APPDATA/documents" },
                { "path": "$APPDATA/documents/.*" },
                { "path": "$APPDATA/documents/*/**" },
                { "path": "$APPDATA/logs" },
                { "path": "$APPDATA/logs/.*" },
                { "path": "$APPDATA/logs/*/**" }
              ]
            },
            {
              "identifier": "fs:allow-rename",
              "allow": [
                { "path": "$APPDATA/photos/*" },
                { "path": "$APPDATA/contracts/*" },
                { "path": "$APPDATA/logs/*" }
              ],
              "deny": [
                { "path": "$APPDATA/photos" },
                { "path": "$APPDATA/photos/.*" },
                { "path": "$APPDATA/photos/*/**" },
                { "path": "$APPDATA/contracts" },
                { "path": "$APPDATA/contracts/.*" },
                { "path": "$APPDATA/contracts/*/**" },
                { "path": "$APPDATA/documents" },
                { "path": "$APPDATA/documents/.*" },
                { "path": "$APPDATA/documents/*/**" },
                { "path": "$APPDATA/logs" },
                { "path": "$APPDATA/logs/.*" },
                { "path": "$APPDATA/logs/*/**" }
              ]
            }
          ]
        }
      ],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/photos/*"]
      }
    }
  },
  "bundle": {
    "active": false
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:respectabullz.db"]
    }
  }
}
