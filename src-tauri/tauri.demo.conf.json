{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Respectabullz Synthetic Demo",
  "identifier": "com.respectabullz.demo",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Respectabullz - Synthetic Portfolio Demo",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "synthetic-demo",
          "description": "Development-only permissions isolated from the production application identity.",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "dialog:default",
            "dialog:allow-open",
            "dialog:allow-save",
            "notification:default",
            "fs:default",
            "fs:allow-exists",
            "fs:allow-mkdir",
            "fs:allow-read-file",
            "fs:allow-stat",
            "fs:allow-write-file",
            "fs:allow-read-dir",
            "fs:allow-remove",
            "fs:allow-rename",
            {
              "identifier": "fs:allow-read",
              "allow": [{ "path": "$APPDATA/**" }]
            },
            {
              "identifier": "fs:allow-write",
              "allow": [{ "path": "$APPDATA/**" }]
            },
            {
              "identifier": "fs:scope",
              "allow": [{ "path": "$APPDATA/**" }]
            },
            "sql:allow-execute",
            "sql:allow-select"
          ]
        }
      ],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": false
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:respectabullz.db"]
    }
  }
}
